<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox maxWidth="250.0" minWidth="250.0" onMouseClicked="#abrirVistaPrevia" prefWidth="250.0" spacing="6.0" styleClass="producto-tarjeta" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.ProductoTarjetaControlador">
    <padding>
        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
    </padding>
    <cursor>
        <Cursor fx:constant="HAND" />
    </cursor>
    <children>
        <StackPane>
            <children>
                <ImageView fx:id="imagen" fitHeight="200.0" fitWidth="222.0" />
            </children>
        </StackPane>
        <Label fx:id="lblMarca" styleClass="producto-marca" />
        <Label fx:id="lblNombre" minHeight="46.0" styleClass="producto-nombre,serif" wrapText="true" />
        <Label fx:id="lblPresentacion" styleClass="producto-presentacion" />
        <Label fx:id="lblDescripcion" maxHeight="72.0" minHeight="72.0" styleClass="producto-descripcion" wrapText="true" />
        <Label fx:id="lblPrecio" styleClass="producto-precio" />
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <children>
                <Button styleClass="boton-agregar" text="Agregar al carrito" />
                <Button styleClass="boton-corazon" text="♡" />
            </children>
        </HBox>
    </children>
</VBox>
