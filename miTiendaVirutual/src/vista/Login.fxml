<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.LoginControlador">
    <top>
        <fx:include fx:id="encabezado" source="Encabezado.fxml" />
    </top>
    <center>
        <StackPane>
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
            <children>
                <HBox maxHeight="530.0" maxWidth="1060.0" prefHeight="530.0" styleClass="login-tarjeta">
                    <children>
                        <VBox minWidth="430.0" prefWidth="430.0" spacing="12.0" styleClass="login-panel-izq">
                            <children>
                                <Region VBox.vgrow="ALWAYS" />
                                <Label styleClass="login-lema,serif" text="Tu rutina, tus favoritos." wrapText="true" />
                                <Label styleClass="login-sub" text="Guarda tu lista de deseos, compra y revisa tu historial." wrapText="true" />
                            </children>
                        </VBox>
                        <VBox alignment="CENTER_LEFT" spacing="16.0" HBox.hgrow="ALWAYS">
                            <padding>
                                <Insets bottom="36.0" left="40.0" right="40.0" top="36.0" />
                            </padding>
                            <children>
                                <Label styleClass="titulo,serif" text="Iniciar sesión" />
                                <TextField fx:id="txtCorreo" promptText="Correo electrónico" styleClass="campo" />
                                <PasswordField fx:id="txtContrasena" promptText="Contraseña" styleClass="campo" />
                                <Label fx:id="lblError" managed="false" styleClass="error" visible="false" />
                                <Button defaultButton="true" maxWidth="1.7976931348623157E308" onAction="#iniciarSesion" styleClass="boton-primario" text="Ingresar" />
                                <VBox alignment="CENTER">
                                    <children>
                                        <Label styleClass="enlace" text="¿No tienes cuenta? Regístrate" />
                                    </children>
                                </VBox>
                                <VBox spacing="2.0" styleClass="cuentas-prueba">
                                    <children>
                                        <Label styleClass="cuentas-titulo" text="Cuentas de prueba" />
                                        <Label styleClass="cuentas-texto" text="Administrador: admin@rouge.com / admin123" />
                                        <Label styleClass="cuentas-texto" text="Usuario: cliente@rouge.com / cliente123" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </StackPane>
    </center>
</BorderPane>
